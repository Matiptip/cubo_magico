<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Cube</title>
    <!-- Link to the external CSS file for styling -->
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Canvas for particle animations -->
    <canvas id="particleCanvas"></canvas>
    <!-- Container for the 3D cube, providing perspective -->
    <div id="container">
        <!-- The 3D cube itself, which will be rotated -->
        <div id="cube">
            <!-- Each face of the cube -->
            <div class="face front">Front</div>
            <div class="face back">Back</div>
            <div class="face right">Right</div>
            <div class="face left">Left</div>
            <div class="face top">Top</div>
            <div class="face bottom">Bottom</div>
        </div>
    </div>

    <!-- Container for the reset button -->
    <div style="text-align: center; margin-top: 20px;"> <button id="resetCube">Reset Cube</button> </div>

    <!-- Link to the external JavaScript file for interactivity -->
    <script src="script.js"></script>
</body>
</html> 
