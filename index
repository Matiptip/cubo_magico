<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Cube</title>
    <!-- Link to the external CSS file for styling -->
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Canvas for particle animations -->
    <canvas id="particleCanvas"></canvas>
    <!-- Container for the 3D cube, providing perspective -->
    <div id="container">
        <!-- The 3D cube itself, which will be rotated -->
        <div id="cube">
            <!-- Each face of the cube -->
            <div class="face front">Front</div>
            <div class="face back">Back</div>
            <div class="face right">Right</div>
            <div class="face left">Left</div>
            <div class="face top">Top</div>
            <div class="face bottom">Bottom</div>
        </div>
    </div>

    <!-- Container for the reset button -->
    <div style="text-align: center; margin-top: 20px;"> <button id="resetCube">Reset Cube</button> </div>

    <!-- Particle Customization Controls -->
    <div id="particleControls" style="position: fixed; bottom: 10px; left: 10px; background-color: rgba(200, 200, 200, 0.7); padding: 10px; border-radius: 5px; z-index: 10;">
        <h4>Particle Settings</h4>
        <div>
            <label for="particleCount">Count:</label>
            <input type="range" id="particleCount" name="particleCount" min="10" max="300" value="100">
            <span id="particleCountValue">100</span>
        </div>
        <div style="margin-top: 5px;">
            <label for="particleSpeed">Speed Multiplier:</label>
            <input type="range" id="particleSpeed" name="particleSpeed" min="0.1" max="3.0" step="0.1" value="1.0">
            <span id="particleSpeedValue">1.0x</span>
        </div>
    </div>

    <!-- Theme Selection Controls -->
    <div id="themeControls" style="position: fixed; bottom: 100px; left: 10px; background-color: rgba(200, 200, 200, 0.7); padding: 10px; border-radius: 5px; z-index: 10;">
        <h4>Color Theme</h4>
        <select id="themeSelector">
            <!-- Options will be populated by JS -->
        </select>
    </div>

    <!-- Click Info Display -->
    <div id="clickInfoDisplay" style="position: fixed; top: 10px; left: 50%; transform: translateX(-50%); background-color: rgba(255, 255, 255, 0.85); padding: 8px 15px; border-radius: 5px; z-index: 10; font-family: Arial, sans-serif; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.2); display: none;">
        Clicked on: <span id="clickedFaceName" style="font-weight: bold;">None</span>
    </div>

    <!-- Link to the external JavaScript file for interactivity -->
    <script src="script.js"></script>

    <!-- Sound Effects -->
    <!-- Note: Actual .wav files need to be present in the same directory or specified path -->
    <audio id="audioRotateStart" src="rotate-start.wav" preload="auto"></audio>
    <audio id="audioFaceChange" src="face-change.wav" preload="auto"></audio>
</body>
</html> 
